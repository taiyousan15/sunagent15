{
  "alwaysThinkingEnabled": true,
  "disabledMcpServers": [
    "figma",
    "qdrant",
    "chroma",
    "n8n-mcp",
    "meta-ads",
    "facebook-ads-library",
    "mcp-memory-service",
    "sequential-thinking",
    "pexels",
    "obsidian",
    "puppeteer",
    "gpt-researcher"
  ],
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "Task",
      "WebFetch",
      "WebSearch"
    ],
    "deny": []
  },
  "preferredModel": "sonnet",
  "mcpServers": {
    "codebase-memory": {
      "type": "stdio",
      "command": "tools/codebase-memory-mcp/codebase-memory-mcp",
      "args": [],
      "disabled": false,
      "defer_loading": true,
      "search_keywords": [
        "codegraph",
        "コードグラフ",
        "依存関係",
        "影響分析",
        "コード検索",
        "関数呼び出し",
        "code search",
        "dependency",
        "impact"
      ],
      "description": "CodeGraph - コードベース知識グラフ検索・影響分析（64言語対応）",
      "category": "code-intelligence"
    }
  },
  "maxParallelAgents": 5,
  "qualityGates": {
    "codeReviewMinScore": 80,
    "testCoverageMin": 80,
    "securityScanRequired": true
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/workflow-sessionstart-injector.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/codegraph-oss-monitor.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/context-snapshot-manager.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/context-snapshot-manager.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/model-auto-switch.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/skill-usage-guard.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/mid-session-reminder.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/agent-enforcement-guard.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 3
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/unified-guard.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/deviation-approval-guard.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit|Task",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/agent-enforcement-guard.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/checkpoint-guard.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/agent-checkpoint-guard.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|Task|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/rules-enforce-guard.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/research-quality-guard.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|Task|MultiEdit|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/cost-hard-stop-guard.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash|Task|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/mistake-pattern-matcher.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/pre-compact-save.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/rules-read-tracker.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/auto-adr.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/definition-lint-gate.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/agent-trace-capture.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/compact-optimizer.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/task-overflow-guard.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/agent-usage-logger.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/output-verifier.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/codegraph-roi-meter.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/codegraph-auto-index.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 12
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/context-snapshot-manager.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/session-handoff-generator.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/contract-audit.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "H=\"${TAISUN_HOME:-.}/.claude/hooks/stop-failure-logger.js\"; [ ! -f \"$H\" ] && exit 0; node \"$H\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}